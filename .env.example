# Security Environment Variables
# Copy this file to .env and update the values

# Session Security
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
NODE_ENV=development

# Database
# Local development defaults to mongodb://localhost:27017/the-wizards-bag.
# For production, either provide the full URI (percent-encode its credentials):
# MONGODB_URI=mongodb+srv://username:encoded-password@cluster.example.mongodb.net/the-wizards-bag

# Or provide these values separately; the app percent-encodes the credentials:
# MONGODB_HOST=cluster.example.mongodb.net
# MONGODB_USERNAME=database-user
# MONGODB_PASSWORD=database-password
# MONGODB_DATABASE=the-wizards-bag

# Public address of the site, used for absolute URLs in sitemap.xml and robots.txt
# SITE_URL=https://www.your-domain.com

# Security Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
# false = not behind a proxy (local dev). true = one proxy hop (Render, Heroku, Nginx).
TRUST_PROXY=false

# Logging
LOG_LEVEL=info

# Development vs Production Settings
# In production, set:
# NODE_ENV=production
# TRUST_PROXY=true (if behind a reverse proxy)
# SESSION_SECRET=a-strong-random-secret-key
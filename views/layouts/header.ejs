<%# Just the site header. The <html>/<head> live in layouts/main.ejs, which includes this file. %>
<header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <div class="d-flex align-items-center justify-content-center w-100">
                    <!-- Left Nav Links -->
                    <ul class="navbar-nav flex-row me-3">
                        <li class="nav-item mx-2">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link" href="/products">Products</a>
                        </li>
                    </ul>
                    
                    <!-- Center Logo -->
                    <a class="navbar-brand p-0 m-0 mx-3" href="/">
                        <img src="/images/logo.png" alt="The Wizard's Bag" width="40" height="60" />
                    </a>
                    
                    <!-- Right Nav Links -->
                    <ul class="navbar-nav flex-row ms-3">
                            <li class="nav-item mx-2">
                                <a class="nav-link" href="/products?category=deck-boxes">Deck Boxes</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link" href="/products?category=tokens">Tokens</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link" href="/products?category=accessories">Accessories</a>
                            </li>
                            <!-- Auth & Cart Links -->
                            <% if (isLoggedIn) { %>
                                <li class="nav-item dropdown mx-2">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user"></i> <%= user.name %>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li><a class="dropdown-item" href="/auth/account"><i class="fas fa-user-circle me-2"></i>My Account</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <%# A small form, because logout is a POST now. Bootstrap's dropdown-item class styles a <button> the same as a link. %>
                                            <form method="POST" action="/auth/logout" class="m-0">
                                                <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            <% } else { %>
                                <li class="nav-item mx-2">
                                    <a class="nav-link" href="/auth/login">Login</a>
                                </li>
                                <li class="nav-item mx-2">
                                    <a class="nav-link" href="/auth/signup">Sign Up</a>
                                </li>
                            <% } %>
                            <li class="nav-item mx-2">
                                <a class="nav-link position-relative" href="/cart" id="cart-link">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" 
                                          id="cart-count" style="display: none;">
                                        0
                                    </span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>